  "info": {
    "title": "Test Exchange API",
    "description": "Crypto exchange training platform API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "John Doe"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          },
          "displayName": {
            "type": "string",
            "example": "John Doe",
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Verify2FaDto": {
        "type": "object",
        "properties": {
          "tempToken": {
            "type": "string",
            "description": "Temporary token from login response when 2FA required"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6-digit TOTP code or 8-char backup code"
          }
        },
        "required": [
          "tempToken",
          "code"
        ]
      },
      "Enable2FaDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6-digit TOTP code from authenticator app"
          }
        },
        "required": [
          "code"
        ]
      },
      "Disable2FaDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6-digit TOTP code or 8-char backup code"
          }
        },
        "required": [
          "code"
        ]
      },
      "DepositDto": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "BTC",
              "ETH"
            ],
            "example": "USD"
          },
          "amount": {
            "type": "number",
            "example": 100,
            "minimum": 0
          }
        },
        "required": [
          "asset",
          "amount"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "example": "BTC_USD",
            "description": "Trading pair (BASE_QUOTE format)"
          },
          "marketType": {
            "type": "string",
            "enum": [
              "spot",
              "futures"
            ],
            "default": "spot",
            "description": "Market type"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "example": "buy"
          },
          "type": {
            "type": "string",
            "enum": [
              "limit",
              "market"
            ],
            "example": "limit"
          },
          "quantity": {
            "type": "number",
            "example": 0.001,
            "minimum": 0
          },
          "price": {
            "type": "number",
            "example": 50000,
            "minimum": 0,
            "description": "Required for limit orders"
          },
          "initialStatus": {
            "type": "string",
            "enum": [
              "open",
              "filled",
              "cancelled"
            ],
            "description": "Initial order status for testing (no counterparty). Default: open"
          }
        },
        "required": [
          "symbol",
          "side",
          "type",
          "quantity"
        ]
      },
      "SetOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "filled",
              "cancelled"
            ],
            "description": "Target status (testing only)"
          }
        },
        "required": [
          "status"
        ]
      },
      "DepositFiatDto": {
        "type": "object",
        "properties": {
          "fiatCurrency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR"
            ]
          },
          "amount": {
            "type": "number",
            "example": 100.5,
            "minimum": 0.01
          },
          "paymentMethodId": {
            "type": "string",
            "description": "Saved payment method ID"
          },
          "paymentMethod": {
            "type": "object",
            "description": "Inline payment (when no saved method)",
            "example": {
              "type": "card",
              "last4": "4242",
              "brand": "visa"
            }
          }
        },
        "required": [
          "fiatCurrency",
          "amount"
        ]
      },
      "AddressRequestDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "example": "BTC"
          }
        },
        "required": [
          "symbol"
        ]
      },
      "DepositCryptoDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "example": "BTC"
          },
          "amount": {
            "type": "number",
            "example": 0.001,
            "minimum": 0.00001
          },
          "walletAddress": {
            "type": "string",
            "example": "bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh"
          },
          "txHash": {
            "type": "string",
            "description": "Blockchain tx hash for confirmation"
          }
        },
        "required": [
          "symbol",
          "amount",
          "walletAddress"
        ]
      },
      "CreatePaymentMethodDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "card",
              "sepa",
              "applepay"
            ]
          },
          "maskedDetails": {
            "type": "object",
            "example": {
              "last4": "4242",
              "brand": "visa"
            },
            "description": "Masked payment details for display"
          }
        },
        "required": [
          "type",
          "maskedDetails"
        ]
      }
    }
  }
}