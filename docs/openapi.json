  "info": {
    "title": "Test Exchange API",
    "description": "Crypto exchange training platform API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "John Doe"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          },
          "displayName": {
            "type": "string",
            "example": "John Doe"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "DepositDto": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string",
            "enum": [
              "USD",
              "BTC",
              "ETH"
            ],
            "example": "USD"
          },
          "amount": {
            "type": "number",
            "example": 100,
            "minimum": 0
          }
        },
        "required": [
          "asset",
          "amount"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "enum": [
              "BTC_USD",
              "ETH_USD"
            ],
            "example": "BTC_USD"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "example": "buy"
          },
          "type": {
            "type": "string",
            "enum": [
              "limit",
              "market"
            ],
            "example": "limit"
          },
          "quantity": {
            "type": "number",
            "example": 0.001,
            "minimum": 0
          },
          "price": {
            "type": "number",
            "example": 50000,
            "minimum": 0,
            "description": "Required for limit orders"
          }
        },
        "required": [
          "symbol",
          "side",
          "type",
          "quantity"
        ]
      }
    }
  }
}