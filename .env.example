# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptosandbox
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Password reset emails (optional). With Mailpit: npm run db:up → set SMTP_HOST=localhost SMTP_PORT=1025 → open http://localhost:8025
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=CryptoSandboxQA <noreply@cryptosandbox.local>
# Optional extra secret for hashing reset codes (defaults to JWT_SECRET)
# PASSWORD_RESET_CODE_PEPPER=

# Mailpit UI port when using docker compose (default 8025). SMTP inside container is 1025; from host use MAILPIT_SMTP_PORT.
# MAILPIT_HTTP_PORT=8025
# MAILPIT_SMTP_PORT=1025

# Optional: milliseconds to wait before persisting orders/deposits (training UX). Default 1200. Use 0 to disable.
# SIMULATED_PERSIST_DELAY_MS=1200

# Admin bootstrap: required for POST /auth/admin/register. Use a strong random value in production.
ADMIN_API_KEY=

# Backend API URL for the Next.js app (must be NEXT_PUBLIC_* for browser code in frontend/lib).
# Next.js reads env from frontend/.env.local — copy this line there, or rely on the default in code.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: same base URL for Node-side UI tests / scripts (e.g. Playwright API helpers). Not used by the Next.js bundle.
API_URL=http://localhost:3001

# Playwright UI tests (package tests/ui-tests/)
# Playwright loads tests/ui-tests/.env (see tests/ui-tests/playwright.config.ts), not this file by default.
# Copy tests/ui-tests/.env.example to tests/ui-tests/.env, or set these in CI / the shell.
# BASE_URL and API_URL (or NEXT_PUBLIC_API_URL) are used for browser baseURL and API helpers respectively.
# BASE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:3000
# ADMIN_API_KEY=  # same as above; required for admin user fixtures in Playwright

# Docker Compose (optional — used when running full stack with docker compose)
# Override these to customize published ports. Leave unset for defaults.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=cryptosandbox
# POSTGRES_PORT=5432
# BACKEND_PORT=3001
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3002
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
