# =============================================================================
# CryptoSandboxQA — root environment
# =============================================================================
# Copy to `.env` at the repository root. Values here are shared by backend,
# tooling, and (first pass) Playwright; browser baseURL for tests lives in
# `tests/ui-tests/.env` — see `tests/ui-tests/.env.example`.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptosandbox

# --- Backend (NestJS) ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Optional: extra secret for password-reset code hashing (defaults to JWT_SECRET).
# PASSWORD_RESET_CODE_PEPPER=

# Optional: simulated delay before persisting orders/deposits (training UX). Default 1200 ms; use 0 to disable.
# SIMULATED_PERSIST_DELAY_MS=1200

# --- Email (optional) ---
# With Mailpit: `npm run db:up` then set SMTP_HOST=localhost SMTP_PORT=1025 — UI http://localhost:8025
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=CryptoSandboxQA <noreply@cryptosandbox.local>

# Mailpit / compose port hints (defaults if unset)
# MAILPIT_HTTP_PORT=8025
# MAILPIT_SMTP_PORT=1025

# --- Frontend and API URLs ---
# NEXT_PUBLIC_* is bundled into the Next.js client (`frontend/`). For local dev you can copy into `frontend/.env.local`.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side and Playwright API helpers (AuthApi, `request` fixture). Usually same host as NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3001

# --- Admin bootstrap ---
# Required for `POST /auth/admin/register`. Use a strong random value in production. Playwright admin fixtures use the same value.
ADMIN_API_KEY=

# --- Playwright UI tests ---
# Optional second file: `tests/ui-tests/.env` (PLAYWRIGHT_BASE_URL, seeds). Loaded after this file.
# `playwright.config.ts` documents order. API tests use API_URL and ADMIN_API_KEY from above.

# --- Docker Compose (optional) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=cryptosandbox
# POSTGRES_PORT=5432
# BACKEND_PORT=3001
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3002
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin


# --- GitHub (optional, local automation only) ---
# Personal access token (classic: repo scope). `gh` reads GH_TOKEN. Keep only in `.env`; do not commit.
# Same shell:  set -a && source .env && set +a
 GH_TOKEN=
# Also used for `gh pr create`, `gh pr merge`, and similar without `gh auth login`.

# --- Jira (optional) ---
 ORGANIZATION_ID=****
 JIRA_API_KEY=*****
