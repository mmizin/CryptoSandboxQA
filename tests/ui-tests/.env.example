# Copy this file to .env in this directory (tests/ui-tests/.env).
# Playwright loads it when the test runner starts (see playwright.config.ts).

# Frontend origin for page.goto('/...') — baseURL in Playwright config (BASE_URL ?? PLAYWRIGHT_BASE_URL).
BASE_URL=http://localhost:3000
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Backend API for AuthApi and fixtures (see src/api/base.api.ts). Same value as root API_URL / NEXT_PUBLIC_API_URL when stack is local.
API_URL=http://localhost:3001

# Required for admin fixtures (AdminApiUserCreationStrategy). Match root ADMIN_API_KEY when using POST /auth/admin/register in tests.
# ADMIN_API_KEY=
