# Playwright package env (merged after repo root `.env` — see `playwright.config.ts`).
# Copy to `tests/ui-tests/.env` to set or override test-runner variables.

# Browser origin for `page.goto('/...')` — `use.baseURL` resolves `BASE_URL ?? PLAYWRIGHT_BASE_URL ??` default in config.
PLAYWRIGHT_BASE_URL=http://localhost:3000
# BASE_URL=http://localhost:3000

# Optional: fixed integer seed for `portfolioAnalyticsLayout` random drag pairs (reproducible CI). Same as TEST_RANDOM_SEED.
PLAYWRIGHT_RANDOM_SEED=12345
