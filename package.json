{
  "name": "crypto-sandbox-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto exchange training platform for QA practice",
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:up": "node scripts/db-up.js",
    "stack:up": "docker compose --profile observability up -d",
    "stack:down": "docker compose --profile observability down",
    "jira:up": "docker compose --profile jira up -d",
    "jira:down": "docker compose --profile jira down",
    "db:down": "node scripts/db-down.js",
    "db:reset": "docker compose down -v",
    "db:dump": "node scripts/dump.js",
    "db:restore": "node scripts/restore.js",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:migrate": "node scripts/migrate.js",
    "backend:dev": "npm run dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:start": "npm run start --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "openapi:generate": "npm run openapi:generate --workspace=backend",
    "frontend:start": "npm run start --workspace=frontend",
    "dev": "npx concurrently \"npm run backend:dev\" \"npm run frontend:dev\""
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "allure": "^3.3.1"
  }
}
